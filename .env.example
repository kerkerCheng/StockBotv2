# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Neo4j connection (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stockbot_dev_pw

# Dedicated least-privilege account for the U7 cloud routine (MATCH + CREATE +
# SET PROPERTY + SET LABEL only — no DELETE, no schema/admin). Not used by
# any local script; exists so the routine's own config never needs the main
# admin credential. See docs/plans/2026-07-10-006-...-plan.md U7a.
NEO4J_ROUTINE_USER=cloud_routine
NEO4J_ROUTINE_PASSWORD=

# Anthropic API key — backup CLI path only.
# NOT needed when using Claude Code skill-based flow (extract, lane memo, analysis all go through Claude Code).
# Only needed for: extract.py batch runs, generate_lane_memo.py CLI, cron automation without Claude Code open.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model for extraction (optional; defaults to claude-sonnet-4-6)
# EXTRACT_MODEL=claude-opus-4-8

# Engine C — Postgres (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockbot
POSTGRES_USER=stockbot
POSTGRES_PASSWORD=stockbot_dev_pw
# Or use a single DSN string (overrides the above):
# POSTGRES_DSN=postgresql://stockbot:stockbot_dev_pw@localhost:5432/stockbot

# EDGAR fetcher — contact email required by SEC fair-access policy
EDGAR_CONTACT_EMAIL=your-email@example.com

# Google Sheets — personal portfolio for position-sizing advice
# (fetchers/gsheets.py, fetchers/build_dashboard.py)
GSHEETS_SPREADSHEET_ID=
# Path to a GCP service account key JSON with Sheets read (or read/write for
# build_dashboard.py) access. Keep this file OUTSIDE version control.
GSHEETS_SERVICE_ACCOUNT_JSON=
# Optional; defaults to "Portfolio"
# GSHEETS_SHEET_NAME=Portfolio

# Graph MCP server (mcp_server/graph_mcp.py) — exposes the knowledge graph to
# claude.ai surfaces (cloud routines, phone app, web) via Cloudflare Tunnel.
# Token is embedded in the connector URL path: https://<host>/<token>/mcp
# Generate: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
GRAPH_MCP_TOKEN=
GRAPH_MCP_PORT=8788
# Remote Git commit/push stays fail-closed until this is explicitly enabled.
# Before enabling, set finalize_research_action to Needs approval in the connector.
ENABLE_REMOTE_FINALIZE=false

# Daily Brief outbound notification — webhook only; never commit .env.
# The webhook points to a private Discord channel. No Discord bot token is needed.
NOTIFY_DISCORD_WEBHOOK_URL=
# Optional numeric Discord user ID to mention in the summary message.
NOTIFY_DISCORD_TAG_USER_ID=
NOTIFY_ENABLED=true
NOTIFY_CHANNEL_ALIAS=private-investing
NOTIFY_CONTENT_CLASS=full_private
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_TIMEOUT_SECONDS=15
