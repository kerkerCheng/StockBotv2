# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Neo4j connection (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stockbot_dev_pw

# Anthropic API key — used by extract.py
ANTHROPIC_API_KEY=sk-ant-...

# Claude model for extraction (optional; defaults to claude-sonnet-4-6)
# EXTRACT_MODEL=claude-opus-4-8

# Engine C — Postgres (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockbot
POSTGRES_USER=stockbot
POSTGRES_PASSWORD=stockbot_dev_pw
# Or use a single DSN string (overrides the above):
# POSTGRES_DSN=postgresql://stockbot:stockbot_dev_pw@localhost:5432/stockbot

# EDGAR fetcher — contact email required by SEC fair-access policy
EDGAR_CONTACT_EMAIL=your-email@example.com
