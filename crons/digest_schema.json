{
  "type": "object",
  "additionalProperties": false,
  "required": ["bullets", "no_material_change"],
  "properties": {
    "bullets": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "text", "lead_ids"],
        "properties": {
          "section": {"type": "string", "enum": ["leads", "events"]},
          "text": {"type": "string"},
          "lead_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "impacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead_id", "target", "verdict", "quote", "sentence"],
        "properties": {
          "lead_id": {"type": "string"},
          "target": {"type": "string"},
          "verdict": {"type": "string", "enum": ["may_touch", "unrelated", "unclear"]},
          "quote": {"type": "string"},
          "sentence": {"type": "string"}
        }
      }
    },
    "no_material_change": {"type": "boolean"}
  }
}
