# Neo4j local data — never commit DB files
.neo4j/
engine_c/.yfinance-cache/
# Engine C 的 SQLite authority 住在 ignored library/private/engine_c/。
# 這裡是安全網：runtime_pointer.json 存的是相對路徑，任何從錯誤 base 解析它的
# 腳本都會被 sqlite3 就地建出一個空 DB（2026-08-08 實際發生過一次）。
# 那種檔案永遠不該進 Git——寧可多忽略，也不要讓 private runtime 檔外洩。
engine_c/*.db
engine_c/*.db-wal
engine_c/*.db-shm
paper_portfolio/config.json
paper_portfolio/transactions.csv

# Secrets
.env
config/*.json
!config/investment_policy.json
!config/company_identity.json
!config/signal_sources.json
!config/daily_routine.json
!config/beta_policy.json
!config/holdings_coverage.json
!config/engine_c_observation_fields.json
!config/decision_blockers.json
!config/authority_tokens.json
!config/lead_ref_keys.json
!config/currency_units.json
!config/lead_classification.json
!config/lead_trace_status.json
!config/target_allocation.json
!config/event_watch.json

# Claude Code 本機設定（不共用）；project skills 轉接層需納入版本控制
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Raw source documents and extraction outputs.
# New and audited legacy repo_full/repo_excerpt artifacts are tracked. Audited
# local_only artifacts remain explicitly denied; missing permission fails closed.
library/raw/*
!library/raw/.gitkeep
!library/raw/*.txt
!library/raw/sivers_ar_2025_photonics_excerpt.meta.json
!library/raw/axti_10_k_20260317.meta.json
!library/raw/axti_10_q_20260514.meta.json
