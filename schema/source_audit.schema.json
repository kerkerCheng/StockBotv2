{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockbot.local/schema/source_audit.schema.json",
  "title": "Source-document audit status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "status", "source_doc_ids", "opened_at", "reason", "review_by", "evidence_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "status": {"enum": ["active", "cleared"]},
    "source_doc_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "opened_at": {"type": "string", "format": "date"},
    "reason": {"type": "string", "minLength": 1},
    "review_by": {"type": ["string", "null"], "format": "date"},
    "evidence_ref": {"type": "string", "minLength": 1}
  }
}
