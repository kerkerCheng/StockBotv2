  "sources": [
    {
      "id": "reuters_inp_export_controls_2026_06_11_s1",
      "locator": "AXT and Coherent para",
      "quote": "AXT, the world's second-largest InP substrate producer and a major supplier to Coherent, said in May that 'InP export permits represent the most significant challenge we currently face.'"
    },
    {
      "id": "reuters_inp_export_controls_2026_06_11_s2",
      "locator": "Supplier switching barriers para",
      "quote": "Companies such as Coherent, mainly supplied by AXT, and Lumentum, mainly supplied by Sumitomo and JX Advanced Metals, are unlikely to switch suppliers easily, as moving to a new supplier requires lengthy qualification cycles, the person said."
    },
    {
      "id": "reuters_inp_export_controls_2026_06_11_s3",
      "locator": "Market share para",
      "quote": "Market leaders AXT and Sumitomo together account for almost 80% of global InP substrate manufacturing, while JX Advanced Metals makes up around 10%."
    },
    {
      "id": "reuters_inp_export_controls_2026_06_11_s4",
      "locator": "Wafer pricing para",
      "quote": "Since China introduced export restrictions on InP, the average price for a 6-inch InP wafer has surged 250% to $5,000."
    },
    {
      "id": "reuters_inp_export_controls_2026_06_11_s5",
      "locator": "Supply chain ripple effects para",
      "quote": "SemiAnalysis' Wang said 'the restrictions ripple through the entire optical supply chain,' beyond AXT and Coherent. Lumentum is sold out through 2028 despite quadrupling output, while Taiwanese optical products makers VPEC and LandMark Optoelectronics faced InP substrate disruptions from AXT permit delays, he said."
    },
    {
      "id": "reuters_inp_export_controls_2026_06_11_s6",
      "locator": "Coherent mitigation para",
      "quote": "Coherent CEO Jim Anderson accompanied President Trump to China in early May to raise export license delays; Coherent is 'doubling its own InP wafer capacity at its Texas plant this year' with plans to 'more than double the capacity again by end of 2027'."
    }
  ]
