      ],
      "statement": "Coherent's InP substrates are mainly supplied by AXT (Reuters, anonymous industry source), and switching InP substrate suppliers requires lengthy qualification cycles — Coherent has direct exposure to AXT's China export permit bottleneck. This is the first non-AXT source for the AXT-to-Coherent supply edge.",
      "subject_id": "e1"
    },
    {
      "confidence": 0.5,
      "demand_proof_level": "inferred",
      "disproof_condition": "A new InP substrate entrant reaches meaningful volume share, or third-party data shows materially lower concentration.",
      "id": "reuters_inp_export_controls_2026_06_11_cl2",
      "source_ids": [
        "reuters_inp_export_controls_2026_06_11_s3"
      ],
      "statement": "Global InP substrate manufacturing is highly concentrated: AXT and Sumitomo together account for almost 80%, JX Advanced Metals around 10% (three players ~90%).",
      "subject_id": "mat:inp_substrate"
    },
    {
      "confidence": 0.5,
      "demand_proof_level": "inferred",
      "disproof_condition": "InP wafer prices retreat toward pre-restriction levels as permits normalize or new capacity comes online.",
      "id": "reuters_inp_export_controls_2026_06_11_cl3",
      "source_ids": [
        "reuters_inp_export_controls_2026_06_11_s4"
      ],
      "statement": "Dated observation (as of 2026-06-11): since China's InP export restrictions, average 6-inch InP wafer price surged 250% to about $5,000 — price evidence of an acute substrate shortage.",
      "subject_id": "mat:inp_substrate"
    },
    {
      "confidence": 0.55,
      "demand_proof_level": "guided",
      "disproof_condition": "Coherent's internal InP wafer capacity expansion is delayed or cancelled, or Coherent states continued reliance on external substrate vendors.",
      "id": "reuters_inp_export_controls_2026_06_11_cl4",
      "source_ids": [
        "reuters_inp_export_controls_2026_06_11_s6"
      ],
      "statement": "Coherent is mitigating substrate dependence by doubling its own InP wafer capacity at its Texas plant in 2026 and plans to more than double it again by end of 2027; its CEO raised China export license delays during a May 2026 U.S. presidential trip to China.",
      "subject_id": "co:coherent"
    },
    {
      "confidence": 0.5,
      "demand_proof_level": "speculative",
      "disproof_condition": "VPEC/LandMark report normalized substrate supply, or Lumentum capacity catches up with demand before 2028.",
