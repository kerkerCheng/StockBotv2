  "sources": [
    {
      "id": "mrvl_celestial_completion_pr_2026_02_02_s1",
      "locator": "paragraph 1",
      "quote": "Marvell Technology, Inc. (NASDAQ: MRVL), a leader in data infrastructure semiconductor solutions, today announced that it has completed its previously announced acquisition of Celestial AI, a pioneer in optical interconnect technology for scale-up connectivity. Celestial AI brings its Photonic Fabric™ optical interconnect technology, designed to support high-bandwidth, low-latency connectivity across large-scale AI deployments."
    },
    {
      "id": "mrvl_celestial_completion_pr_2026_02_02_s2",
      "locator": "paragraph 2",
      "quote": "This positions the combined company to be a technology leader in the emerging scale-up interconnect market, adding a significant and completely incremental new total addressable market (TAM)."
    }
  ]
