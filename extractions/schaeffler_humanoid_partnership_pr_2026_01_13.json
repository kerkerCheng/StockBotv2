  "sources": [
    {
      "id": "schaeffler_humanoid_partnership_pr_2026_01_13_s1",
      "locator": "PR — supplier position",
      "quote": "Schaeffler is becoming the preferred supplier of actuators for wheeled systems."
    },
    {
      "id": "schaeffler_humanoid_partnership_pr_2026_01_13_s2",
      "locator": "PR — reciprocal robot integration",
      "quote": "Schaeffler is planning to integrate several hundred humanoids into its global production network over the next five years to further increase the automation and efficiency of its production processes."
    },
    {
      "id": "schaeffler_humanoid_partnership_pr_2026_01_13_s3",
      "locator": "PR — scope",
      "quote": "The collaboration will focus on the development and supply of key components, including innovative actuators used in both wheeled-base and bipedal (two-legged) humanoids."
