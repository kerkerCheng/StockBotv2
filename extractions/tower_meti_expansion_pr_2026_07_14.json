  "sources": [
    {
      "id": "tower_meti_expansion_pr_2026_07_14_s1",
      "locator": "PR para 1",
      "quote": "announced a parallel dual-track strategic expansion of its 300mm Silicon Photonics (SiPho), Silicon Germanium (SiGe), and advanced packaging capabilities in Japan, with support from the Government of Japan"
    },
    {
      "id": "tower_meti_expansion_pr_2026_07_14_s2",
      "locator": "PR track one para",
      "quote": "Track one adds significant new 300mm Silicon Photonics capacity, with full production readiness expected during the fourth quarter of 2027"
    },
    {
      "id": "tower_meti_expansion_pr_2026_07_14_s3",
      "locator": "PR track two para",
      "quote": "expected to provide a multi-fold increase in Silicon Photonics and Silicon Germanium capacity, positioning Tower to support continued accelerating customer demand for emerging AI and data center applications"
    },
    {
      "id": "tower_meti_expansion_pr_2026_07_14_s4",
      "locator": "PR investment scope para",
      "quote": "The scope of the dual-track expansion is forecasted to be an approximate $3 billion Tower's investment, net of grants of $1 billion, to be provided by the Government of Japan."
    },
    {
      "id": "tower_meti_expansion_pr_2026_07_14_s5",
      "locator": "PR track two para",
      "quote": "Track two will commence in parallel with the first track and consists of constructing an additional 300mm manufacturing facility, adjacent to Fab 7, following signing and closing of related agreements."
    }
  ]
