  "sources": [
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s1",
      "locator": "問詢回覆——美國關稅政策對標的公司向美國 BE 公司銷售的影響（PDF 斷行接回）",
      "quote": "标的公司外销客户中，印度MTAR 及高力热处理工业股份有限公司均为美国BE 的供应商，标的公司销售给印度MTAR 及高力热处理工业股份有限公司的产品最终销售至美国BE。"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s2",
      "locator": "問詢回覆——前五大客戶貢獻變化的原因（PDF 斷行接回）",
      "quote": "鉴于美国BE 公司在2025 年完成供应链调整，标的公司部分直接销售给美国BE 公司的产品通过向中国台湾和印度地区的厂商销售，并由其在当地加工或组装完成后运往美国或美国BE 公司指定地点"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s3",
      "locator": "問詢回覆——BE 近期訂單整理表（引公開資訊；證明文件裡的 BE 即 Bloom Energy）",
      "quote": "2026 年4 月 甲骨文 扩大与BloomEnergy 合作，计划采购2.8GWSOFC 燃料电池，首期签约1.2GW"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s4",
      "locator": "問詢回覆首頁（發行人自稱）",
      "quote": "浙江春晖智能控制股份有限公司（以下简称“公司”“上市公司”或“春晖智控”）"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s5",
      "locator": "問詢回覆 1．关于本次交易目的（申报文件显示）",
      "quote": "上市公司拟发行股份及支付现金购买浙江春晖仪表股份有限公司（以下简称标的资产）61.3106%的股权。上市公司主营业务为流体控制阀和控制系统的研究、开发、制造；标的资产主营业务为温度传感器、微型铠装电加热材料及元器件的研发、生产及销售"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s6",
      "locator": "問詢回覆——燃料电池市场概述",
      "quote": "标的公司在燃料电池市场的业务主要为固体氧化物燃料电池（SOFC）温度传感器的研发、生产和销售。"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s7",
      "locator": "問詢回覆——产业竞争格局 1、燃料电池领域",
      "quote": "标的公司目前在燃料电池领域主要专注于 SOFC 的测温产品，境外客户为美国 BE 公司，在该客户的主要竞争对手为日本冈崎制作所。"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s8",
      "locator": "同上（合作沿革）",
      "quote": "至 2007 年标的公司实现向 BE 公司批量供货。"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s9",
      "locator": "問詢回覆——标的资产与其他供应商在产品技术先进性及定价上的差异情况",
      "quote": "标的公司向 BE 公司所销售的温度传感器和测试线对于 BE 公司的燃料电池产品安全性和稳定性具有至关重要的作用"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s10",
      "locator": "問詢回覆——修订后的收购整合风险提示",
      "quote": "尽管上市公司已经持有标的公司 38.69%股权，并向标的公司委派了董事、监事和高管"
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s11",
      "locator": "問詢回覆——美国 BE 同类产品采购情况（中介机构访谈）",
      "quote": "经中介机构向美国 BE 访谈了解，除了向标的公司采购以外，同类产品向其他供应商采购情况如下："
    },
    {
      "id": "chunhui_szse_inquiry_reply_2026_09_22_be_suppliers_s12",
      "locator": "同上（表：客户名称／主要采购产品／占客户采购同类产品的比例／其他供应商；PDF 抽字後的列序）",
      "quote": "BE 公司\n温度传感器\n70%以上\n日本冈崎制作所"
    }
  ]
