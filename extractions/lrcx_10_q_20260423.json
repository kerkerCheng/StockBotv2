  "sources": [
    {
      "id": "lrcx_10_q_20260423_s1",
      "locator": "MD&A intro, chars 31900-34300",
      "quote": "Systems revenue includes sales of new leading-edge equipment in deposition, etch, clean and other wafer fabrication markets. Customer support-related revenue includes sales of customer service, spares, upgrades, and non-leading-edge equipment from the Company's Reliant® product line."
    },
    {
      "id": "lrcx_10_q_20260423_s2",
      "locator": "MD&A intro, chars 31900-34300",
      "quote": "China $ 1,996,926   $ 1,467,299   $ 6,138,046   $ 4,368,501"
    },
    {
      "id": "lrcx_10_q_20260423_s3",
      "locator": "MD&A intro, chars 31900-34300",
      "quote": "Foundry 54   % 48   % 58   % 42   % Memory 39   % 43   % 36   % 43   % Logic/integrated device manufacturing 7   % 9   % 6   % 15   %"
    },
    {
      "id": "lrcx_10_q_20260423_s4",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "Lam Research Corporation is a global supplier of innovative wafer fabrication equipment and services to the semiconductor industry."
    },
    {
      "id": "lrcx_10_q_20260423_s5",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "Demand from cloud computing, artificial intelligence (\"AI\"), 5G, the Internet of Things, and other markets is driving the need for increasingly powerful and cost-efficient semiconductors."
    },
    {
      "id": "lrcx_10_q_20260423_s6",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "we believe there will be continued growth in 2026 with the AI market driving higher semiconductor industry spending across both the memory and non-memory market segments."
    },
    {
      "id": "lrcx_10_q_20260423_s7",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "revenue increased 9% compared to the three months ended December 28, 2025, driven by an increase in systems revenue primarily resulting from increased customer investments in the DRAM market segment as well as an increase in customer support-related revenue mainly tied to our expanding installed base and higher spares, upgrades and services revenue, partially offset by decreased customer spend on non-leading-edge equipment."
    },
    {
      "id": "lrcx_10_q_20260423_s8",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "volatility in the semiconductor industry environment from trade restrictions, tariffs, as well as other direct and indirect risks and uncertainties discussed in Part II, Item 1A, \"Risk Factors,\" have had, and in the future may have, a negative impact on our revenue and operating margin."
    },
    {
      "id": "lrcx_10_q_20260423_s9",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "technology inflections in our industry, including 3D device scaling, multiple patterning, process flow, and advanced packaging chip integration, will drive sustainable growth and lead to an increase in the served available market for our products and services in the deposition, etch, and clean businesses."
    },
    {
      "id": "lrcx_10_q_20260423_s10",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "$331.6 million of capital expenditures"
    },
    {
      "id": "lrcx_10_q_20260423_s11",
      "locator": "Risk Factors, chars 112300-113200",
      "quote": "changes in import/export regulations and tariffs, such as regulations imposed by the U.S. government restricting exports to China or regulations imposed by other countries restricting the export of certain materials or the re-export of products containing such materials"
    },
    {
      "id": "lrcx_10_q_20260423_s12",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "Our Customer Support Business Group provides products and services to maximize installed equipment performance, predictability, and operational efficiency."
    },
    {
      "id": "lrcx_10_q_20260423_s13",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "Our core technical competency is integrating hardware, process, materials, software, and process control, enabling results on the wafer."
    },
    {
      "id": "lrcx_10_q_20260423_s14",
      "locator": "MD&A executive summary, chars 63900-72400",
      "quote": "Wafer fabrication equipment investments were strong in the 2025 calendar year, and we believe there will be continued growth in 2026 with the AI market driving higher semiconductor industry spending across both the memory and non-memory market segments."
    }
  ],
