  "sources": [
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s1",
      "locator": "Introduction, para 1",
      "quote": "hyperscale data centers where tens of thousands of CPU and GPU clusters are deployed, and data transfer rates are growing exponentially… key considerations today include speed, bandwidth, power efficiency, and cost… based on data from OpenAI and Broadcom's official reports."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s2",
      "locator": "Introduction, para 1",
      "quote": "advanced packaging technologies have emerged as an effective alternative with rapid developments in 3D chiplets hetero-integration and co-packaged optics (CPO)"
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s3",
      "locator": "Advanced Packaging Technology, InFO section",
      "quote": "TSMC's Integrated Fan-Out (InFO) is a representative FO package… This technology directly uses RDLs and Through InFO Via (TIV) to connect chips to the PCB, significantly reducing parasitic parameters associated with bonding wires."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s4",
      "locator": "Advanced Packaging Technology, InFO section",
      "quote": "TSMC's InFO technology has been used in Apple's A-series processors and DRAM co-packages."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s5",
      "locator": "Advanced Packaging Technology, 2D CPO section",
      "quote": "Figure 6 shows Compact Optical Universal Photonic Engine (COUPE) designed by TSMC in 2021. COUPE is a groundbreaking technology designed to address the growing demand for high-performance computing, networking, and communication systems."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s6",
      "locator": "Advanced Packaging Technology, 2.5D section",
      "quote": "TSMC's Chip-on-Wafer-on-Substrate (CoWoS)… Multiple dies with different functions are interconnected by RDLs and TSVs in the silicon interposer, enabling ultra-high-density, high-performance packaging. This is particularly suitable for AI and supercomputing applications."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s7",
      "locator": "Advanced Packaging Technology, 2.5D section",
      "quote": "Samsung's Interposer Cube 4 (I-Cube4) is an advanced 2.5D silicon interposer packaging technology that utilizes stacking to integrate multiple components, such as memory and logic chips, into a compact and high-performance package."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s8",
      "locator": "Advanced Packaging Technology, 2.5D section",
      "quote": "TSMC's CoWoS-S integrates multiple chips in a 2.5D configuration, utilizing a silicon interposer that connects high-bandwidth memory (HBM) to logic chips… CoWoS-S also emphasizes high-density interconnects and efficient heat dissipation for large-scale data center and AI applications."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s9",
      "locator": "Advanced Packaging Technology, 2.5D section",
      "quote": "Samsung's I-Cube4… incorporates HBM with logic… designed to support even higher integration density and bandwidth, positioning it for cutting-edge applications requiring extreme performance, like AI accelerators and networking systems."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s10",
      "locator": "Advanced Packaging Technology, 2.5D CPO section",
      "quote": "Figure 9 shows a silicon-based CPO designed by IME of Chinese Academy. In this package, the PIC and EIC are connected by TSVs and three RDLs. The RDL line width and space can be less than 10 um."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s11",
      "locator": "Advanced Packaging Technology, 2.5D CPO section",
      "quote": "Another example is glass substrate CPO designed by Corning, USA… The PIC is connected to optical fibers by the glass waveguides fabricated with ion exchange (IOX) technology."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s12",
      "locator": "Advanced Packaging Technology, 3D stacking section",
      "quote": "One typical example for 3D electrical chip stacking is Intel Foveros, in which various IP chips with different types of processes are directly stacked together with TSVs and bumps… Foveros has been applied on a MAX series GPU."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s13",
      "locator": "Advanced Packaging Technology, 3D stacking section",
      "quote": "Samsung's X-Cube is designed to provide high-performance integration for complex semiconductor applications. It utilizes a cutting-edge 3D stacking architecture to combine multiple logic and memory chips into a single compact package."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s14",
      "locator": "Advanced Packaging Technology, 3D CPO section",
      "quote": "An example is Broadcom 3D Silicon CPO… PIC is flip-chip above EIC which is connected to switch ASIC through the substrate. In this application, four CPO packages in total are adopted, which can support 12.8 Tb/s bandwidth. Power and cost are reduced by 40% with this configuration."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s15",
      "locator": "Advanced Packaging Technology, 3D CPO section",
      "quote": "For 3D glass CPO integration, Intel has announced it for the next generation of high-power processors… Intel is on the path to delivering 1 trillion transistors on a package by 2030, and its ongoing innovation in advanced packaging including glass substrates will help achieve this goal."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s16",
      "locator": "Future Prospects section",
      "quote": "glass-based CPO products are very promising for being employed in the near future hyperscale datacenter with a huge amount of CPUs and GPUs… Glass-based Co-Packaged Optics (CPO) represents a transformative shift in data center networking."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s17",
      "locator": "Future Prospects section",
      "quote": "challenges in cost and manufacturing remain… demands for ultra-low latency and high-speed connections rise which cannot be satisfied by Moore's Law and silicon-based CPO technology."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s18",
      "locator": "Future Prospects section",
      "quote": "Many commercial EDA software such as Cadence and Ansys Lumerical are also available for efficient simulation."
    },
    {
      "id": "Electronic_Chip_Package_and_CPO_Technology_for_Modern_AI_Era_s19",
      "locator": "Advanced Packaging Technology, CoWoS comparison section",
      "quote": "Both innovations push the envelope in 2.5D packaging, but Samsung's solution tends to emphasize greater interconnect scalability."
    }
  ],
