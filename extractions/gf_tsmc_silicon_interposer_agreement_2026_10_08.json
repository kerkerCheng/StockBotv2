  "sources": [
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s1",
      "locator": "第一段",
      "quote": "GlobalFoundries (Nasdaq: GFS) (GF) today announced a manufacturing agreement with TSMC to establish a U.S.-based supply of silicon interposers for TSMC’s CoWoS ® advanced packaging ecosystem."
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s2",
      "locator": "第一段",
      "quote": "Under the agreement, GF will provide manufacturing service to TSMC, and add fabrication capacity at its Malta, New York facility, supporting growing demand for high-performance computing and AI systems."
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s3",
      "locator": "第二段",
      "quote": "GF expects to expand capacity at its Malta facility and establish the first U.S.-based source of silicon interposers supporting advanced packaging technologies, including embedded deep trench capacitor components."
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s4",
      "locator": "時程與年限",
      "quote": "Volume production is expected to begin ramping at GF’s Malta site during the first half of 2028. The agreement has an initial term of five years and provides a framework for future capacity expansion."
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s5",
      "locator": "高層引述（Ed Kaste）",
      "quote": "Advanced packaging is becoming increasingly critical to delivering the performance, power efficiency and scale required for next-generation AI systems,"
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s6",
      "locator": "副標題（正文第一段 <p><em>）",
      "quote": "Multi-year $2 billion agreement will expand capacity for advanced packaging ecosystem and support growing demand for AI and high-performance computing technologies"
    },
    {
      "id": "gf_tsmc_silicon_interposer_agreement_2026_10_08_s7",
      "locator": "第一段末句",
      "quote": "The agreement provides a foundation to expand capacity over time as customer demand grows."
    }
  ]
