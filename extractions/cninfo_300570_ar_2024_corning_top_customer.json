    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s1",
      "locator": "第三节 管理层讨论与分析——（8）主要销售客户（公司前 5 大客户资料）",
      "quote": "1 Corning Incorporated 965,808,265.22 70.10%"
    },
    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s2",
      "locator": "同表",
      "quote": "前五名客户合计销售金额占年度销售总额比例 83.03%"
    },
    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s3",
      "locator": "第三节（三）公司所处行业地位",
      "quote": "公司是全球最大的光密集连接产品制造商之一，部分无源光器件产品(如 MTP/MPO 高密度光纤连接器、光柔性板)的技术水平在细分行业中处于领先地位，占据重要市场份额"
    },
    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s4",
      "locator": "第三节 四、主营业务分析——1、概述",
      "quote": "随着 AI 技术的突破与算力需求的爆发，全球数据中心建设进入高速扩张期，推动了密集连接技术的迭代升级与应用推广。"
    },
    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s5",
      "locator": "同段",
      "quote": "以 MTP/MPO 为代表的高密度连接产品，通过集成化设计实现了成本优化、性能提升与运维便捷性。"
    },
    {
      "id": "cninfo_300570_ar_2024_corning_top_customer_s6",
      "locator": "同段",
      "quote": "算力网络建设的加速、 400G/800G 光模块的普及促使光口向多通道演进，CPO 技术的逐步商用也推动了高密度连接产品的需求增长。"
    }
  ]
