      "id": "gxo_agility_raas_deployment_2024_06_27_s1",
      "locator": "announcement, opening paragraph",
      "quote": "GXO … and Agility Robotics … announced today that they have signed a multi-year agreement to begin deploying Digit in GXO’s logistics operations."
    },
    {
      "id": "gxo_agility_raas_deployment_2024_06_27_s2",
      "locator": "announcement, deployment description",
      "quote": "As part of the RaaS agreement, GXO is deploying Digit robots and Agility Arc™, Agility’s cloud automation platform for deploying and managing Digit fleets."
    },
    {
      "id": "gxo_agility_raas_deployment_2024_06_27_s3",
      "locator": "announcement, SPANX facility use case",
      "quote": "Digit robots are assisting with repetitive tasks such as moving totes from cobots and placing them onto conveyors, all orchestrated through Agility Arc."
    },
    {
      "id": "gxo_agility_raas_deployment_2024_06_27_s4",
      "locator": "announcement, RaaS paragraph",
      "quote": "Under the RaaS agreement, the companies will continue to explore additional use cases and scale Digit usage to meet demand throughout the deployment."
    }
