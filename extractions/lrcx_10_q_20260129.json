  "claims": [
    {
      "id": "lrcx_10_q_20260129_cl1",
      "statement": "China represented 35% of Lam Research revenue in the December 2025 quarter, up from 34% in the prior-year six-month period, indicating sustained and growing dependence on Chinese customers for equipment spending.",
      "subject_id": "co:lam_research",
      "demand_proof_level": "confirmed",
      "disproof_condition": "If U.S. export controls materially restrict Lam's ability to ship equipment to China and China's share of revenue falls below 20% for two consecutive quarters, this claim should be downgraded.",
      "confidence": 0.9,
      "source_ids": [
        "lrcx_10_q_20260129_s2",
        "lrcx_10_q_20260129_s3"
      ]
    },
    {
      "id": "lrcx_10_q_20260129_cl2",
      "statement": "DRAM investment by memory customers strengthened in the December 2025 quarter while NAND (non-volatile memory) spending declined, reflecting a bifurcation in memory equipment demand driven by AI workloads.",
      "subject_id": "tech:dram_manufacturing",
      "demand_proof_level": "confirmed",
      "disproof_condition": "If NAND spending recovers to parity with DRAM in subsequent quarters, the bifurcation thesis should be revised.",
      "confidence": 0.9,
      "source_ids": [
        "lrcx_10_q_20260129_s5"
      ]
    },
    {
      "id": "lrcx_10_q_20260129_cl3",
      "statement": "U.S. government export controls restricting exports to China represent a material risk to Lam Research's revenue, given China's ~35-43% share of quarterly revenue.",
      "subject_id": "co:lam_research",
      "demand_proof_level": "guided",
      "disproof_condition": "If export controls are relaxed or Lam successfully diversifies revenue so China represents less than 15% of revenue, this claim should be downgraded.",
      "confidence": 0.85,
      "source_ids": [
        "lrcx_10_q_20260129_s8",
        "lrcx_10_q_20260129_s3"
      ]
    },
    {
      "id": "lrcx_10_q_20260129_cl4",
      "statement": "Foundry equipment spending was the predominant growth driver for Lam Research in H1 FY2026 (six months ended December 2025), with foundry representing 60% of leading- and non-leading-edge equipment revenue versus 38% in the prior-year period.",
      "subject_id": "tech:foundry_logic",
      "demand_proof_level": "confirmed",
      "disproof_condition": "If foundry share drops back below 45% for two consecutive quarters, this claim should be revised.",
      "confidence": 0.9,
      "source_ids": [
        "lrcx_10_q_20260129_s4",
        "lrcx_10_q_20260129_s9"
      ]
