    {
      "id": "sivers_gf_pr_2026_06_02_s2",
      "locator": "press release, para 1",
      "quote": "Sivers Semiconductors' laser arrays will be integrated into reference designs built on GF's silicon photonics platform"
    },
    {
      "id": "sivers_gf_pr_2026_06_02_s3",
      "locator": "press release, para 1",
      "quote": "The collaboration supports a range of optical connectivity architectures, including co-packaged optics (CPO), linear pluggable optics (LPO), and other emerging data center interconnect solutions"
    },
    {
      "id": "sivers_gf_pr_2026_06_02_s4",
      "locator": "press release, para 1",
      "quote": "Sivers' laser arrays will also be available in GF's Silicon Photonics Co-packaged Advanced Light Engine (SCALE™) platform for next-generation optical sub-assemblies and light engine architectures"
    }
