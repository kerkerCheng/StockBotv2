  "sources": [
    {
      "id": "nvidia_uber_robotaxi_hyperion10_pr_2025_10_28_s1",
      "locator": "Press release body（第 3 段）",
      "quote": "NVIDIA DRIVE AGX Hyperion 10 is a reference production computer and sensor set architecture that makes any vehicle L4-ready."
    },
    {
      "id": "nvidia_uber_robotaxi_hyperion10_pr_2025_10_28_s2",
      "locator": "Press release body（第 2 段）",
      "quote": "By enabling faster growth across the level 4 ecosystem, NVIDIA can support Uber in scaling its global autonomous fleet to 100,000 vehicles over time, starting in 2027."
    },
    {
      "id": "nvidia_uber_robotaxi_hyperion10_pr_2025_10_28_s3",
      "locator": "Press release body（Hyperion 10 規格段）",
      "quote": "The NVIDIA DRIVE AGX Hyperion 10 production platform features the NVIDIA DRIVE AGX Thor system-on-a-chip; the safety-certified NVIDIA DriveOS™ operating system; a fully qualified multimodal sensor suite including 14 high-definition cameras; nine radars, one lidar and 12 ultrasonics; and a qualified board design."
    },
    {
      "id": "nvidia_uber_robotaxi_hyperion10_pr_2025_10_28_s4",
      "locator": "Press release body（Hyperion 10 規格段）",
      "quote": "At the core of DRIVE AGX Hyperion 10 are two performance-packed DRIVE AGX Thor in-vehicle platforms based on NVIDIA Blackwell architecture."
    },
    {
      "id": "nvidia_uber_robotaxi_hyperion10_pr_2025_10_28_s5",
      "locator": "Press release body（第 4 段）",
      "quote": "Uber is bringing together human drivers and autonomous vehicles into a single operating network — a unified ride-hailing service including both human and robot drivers. This network, powered by NVIDIA DRIVE AGX Hyperion-ready vehicles and the surrounding AI ecosystem, enables Uber to seamlessly bridge today’s human-driven mobility with the autonomous fleets of tomorrow."
    }
  ]
