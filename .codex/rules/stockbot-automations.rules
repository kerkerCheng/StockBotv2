# Codex standalone scheduled task 會沿用 workspace-write sandbox；以下 fixed entry
# （條數由 tests/test_codex_daily_permissions.py 斷言，刻意不寫在這裡——寫死的數字會腐壞）
# 是 Daily 唯一的 outside-sandbox 權限來源。首次呼叫就使用 exact rule，不先失敗再重跑；
# 不放行任意 Python、PowerShell、shell、Git 或 working tree。
#
# ⚠ fetchers 目錄**不是**整包放行：只有 edgar.py 與 mops.py 兩支公開文件下載器在列。
# 同目錄的 gsheets.py 會使用 Google service account 憑證，屬 credential-bearing surface，
# 刻意不放行；要動它必須另做 impact review。
prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "crons\\harvest_leads.py"],
    decision="allow",
    justification="Daily harvest 需要連 X API 與 SEC EDGAR，憑證與 source_state 都留在本機。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "engine_c\\etl_yfinance.py"],
    decision="allow",
    justification="Daily Engine C ETL 需要連 Yahoo Finance 並只寫 ignored private runtime。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\alpha_purity_snapshot.py"],
    decision="allow",
    justification="Daily Alpha purity consumer 只讀 owner-only Engine C authority，輸出正規化市值與分析師覆蓋，不寫任何 authority。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "fetchers\\edgar.py"],
    decision="allow",
    justification="Daily pq1 source-trace 只從 SEC EDGAR 下載指定 ticker／form 的公開原始文件到本機 raw store。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "fetchers\\mops.py"],
    decision="allow",
    justification="Daily pq1 source-trace 的台股對應項：只從公開資訊觀測站（doc.twse.com.tw）下載指定代號的公開年報／財報到本機 raw store，與 edgar.py 同構。無憑證、不碰 Windows identity／ACL、不寫 private authority、不觸 .git。台股 issuer 的客戶集中度只在 MOPS 年報揭露，公司 IR 網頁為動態載入抓不到。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\daily_beta_snapshot.py"],
    decision="allow",
    justification="Daily beta fixed entry 只刷新 Engine C technical observations、唯讀 Sheet 並產人工 review，不下單或寫 Sheet。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.cli", "list"],
    decision="allow",
    justification="Daily pending lead priority list 需要唯讀 Google Sheet 持股與本機 Neo4j chokepoint context。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.cli", "drain"],
    decision="allow",
    justification="Daily pq1 drain 需要唯讀 private Decision work orders、Google Sheet 持股與本機 Neo4j chokepoint context。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\catalyst_watch.py"],
    decision="allow",
    justification="Daily catalyst watch 只讀 owner-only private Decision Store 與 tracked thesis lifecycle。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\outcome_if_settled_today.py"],
    decision="allow",
    justification="Daily Alpha Pane 4 只讀 private Decision Store 與最新已收盤行情，計算 live／shadow 報酬，不寫任何 authority。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\prepare_research_action.py", "--action-file"],
    decision="allow",
    justification="Daily pq1 只把已驗證 action draft 凍結到 ignored private staging；不寫 Neo4j、不 apply、不建立 live permission。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\publish_daily_state.py"],
    decision="allow",
    justification=(
        "固定 publisher 提交四個 leads state files（pending_leads／todo_pool／"
        + "event_watches／hypotheses）並推送 master。2026-09-04 起同時帶上"
        + "**被那份 state 指名引用、且確實存在**的 library/raw/ 追源原文——"
        + "集合由 state 推導而來，不是整目錄放行；上限 20 份，超過 fail closed。"
        + "命令、旗標與 OS／網路能力皆未改變（同一支腳本、同一組 git 動作）。"
    ),
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "decision_lab", "today"],
    decision="allow",
    justification="Daily decision brief 只讀 Google Sheet、Neo4j 與 private Decision authorities。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.todo", "sync"],
    decision="allow",
    justification="Daily todo sync 只同步本機 approval authorities 到 stable todo pool。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.todo", "work"],
    decision="allow",
    justification="Daily 只 checkpoint 已由使用者 exact go 且已 dispatch 的 decision-review work order；不 dispatch、不 resolve、不 reassess，也不跨越 graph 或 live gate。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.todo", "reassess-stale"],
    decision="allow",
    justification="研究閉環 P5（2026-09-09）佇列段 2：對「只因凍結 context 過期而 REVIEW、blocker 純 system_internal」的 decision_review 執行 reassess（decision_lab.workflow.reassess，append 新 decision、舊筆不動），新 decision 不再 REVIEW 才以 decision receipt 結案。需要 Neo4j／Engine C／Google Sheet（readonly）同一組本機資源，無新增主機或憑證。候選判定重用 blocker registry 的 resolution_mode，不猜；帶 user_decision 或 awaiting_external blocker 的一律不碰。不 dispatch、不 resolve 使用者項、不入圖、不動 live。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.todo", "standing-go"],
    decision="allow",
    justification="研究閉環 P5（2026-09-09）佇列段 2b：對 config/standing_authorization.json 列為 authorized 的 pq2 類型（decision_review、source_trace_review）執行使用者本來會下的 go——同一個 advance_decision_review／dispatch_source_trace_review，只是按鍵的人從使用者換成 config；receipt 與 gate 完全相同。config 載入時驗封閉性（每種類型必須明寫 authorized 或 never，四個 gate 類型永遠 never）；使用者明示 pending、在等世界、hint 提及付費的一律跳過。不入圖、不寫 Engine C 判讀、不動 thesis、不動 live。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "webapp", "materialize"],
    decision="allow",
    justification="Daily 收尾把 APP 讀的判讀重算一次並寫進 ignored derived cache（library/private/app/）。讀 Neo4j、Engine C SQLite、private ledger 與 Google Sheet（readonly）——與 daily_beta_snapshot.py／decision_lab today 同一組本機資源，無新增網路主機或憑證；不寫任何 authority、不入圖、不建 decision、不碰 .git 或 tracked 檔。⚠ 只放行 materialize 子命令：同一個模組的 serve 會綁定本機 port（新增 listener surface），刻意不在列——那是開機自啟的長駐服務，不是排程動作。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\publish_daily_brief.py"],
    decision="allow",
    justification="Discord publisher 只把 canonical Daily Brief 送到既有 private Forum webhook。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\backfill_fiscal_year_results.py"],
    decision="allow",
    justification="研究閉環 P7-a（2026-09-10）：把段 5 backlog 裡卡在「Engine C 無 fiscal_year_results 觀測」的美股標的，用 SEC XBRL companyfacts 補上基期實績（revenue、gaap.operating_income 兩個數）。網路只連 data.sec.gov 與 www.sec.gov 的公開端點，與既有的 fetchers\edgar.py 同一組主機、無憑證。寫入 Engine C SQLite 的 manual_observations（ignored private runtime），且**只寫得了 fiscal_year_results 這一個 verifiability=mechanical 欄位**——腳本啟動時以 observation_fields registry 驗證，非 mechanical 直接 exit 3；FIELD 是常數、無 CLI 參數可改。mechanical 依 AGENTS.md 明定不需 pq2，其補償控制（value 必須是可機械比對的 JSON 數值）由 append_manual_observation 強制，另加白名單 tag 歧異拒寫、20-F/10-K 年報期間限定、單一幣別、source_filed_at 取 accession 的 filed 日期（不得用今天）、基期超過 550 天拒寫五道。不寫任何判讀欄位、不入圖、不建 decision、不動 thesis、不動 live、不碰 .git 或 tracked 檔。⚠ 只放行這一支：同目錄的 record_mechanical_observation.py 接受任意 --field，刻意不在列。",
)
