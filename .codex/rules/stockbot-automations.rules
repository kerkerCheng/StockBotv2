# Codex standalone scheduled task 會沿用 workspace-write sandbox；以下十三個 fixed entry
# 是 Daily 唯一的 outside-sandbox 權限來源。首次呼叫就使用 exact rule，不先失敗再重跑；
# 不放行任意 Python、PowerShell、shell、Git 或 working tree。
prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "crons\\harvest_leads.py"],
    decision="allow",
    justification="Daily harvest 需要連 X API 與 SEC EDGAR，憑證與 source_state 都留在本機。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "engine_c\\etl_yfinance.py"],
    decision="allow",
    justification="Daily Engine C ETL 需要連 Yahoo Finance 並只寫 ignored private runtime。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "fetchers\\edgar.py"],
    decision="allow",
    justification="Daily pq1 source-trace 只從 SEC EDGAR 下載指定 ticker／form 的公開原始文件到本機 raw store。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\daily_beta_snapshot.py"],
    decision="allow",
    justification="Daily beta fixed entry 只刷新 Engine C technical observations、唯讀 Sheet 並產人工 review，不下單或寫 Sheet。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.cli", "list"],
    decision="allow",
    justification="Daily pending lead priority list 需要唯讀 Google Sheet 持股與本機 Neo4j chokepoint context。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.cli", "drain"],
    decision="allow",
    justification="Daily pq1 drain 需要唯讀 private Decision work orders、Google Sheet 持股與本機 Neo4j chokepoint context。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\catalyst_watch.py"],
    decision="allow",
    justification="Daily catalyst watch 只讀 owner-only private Decision Store 與 tracked thesis lifecycle。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\outcome_if_settled_today.py"],
    decision="allow",
    justification="Daily Alpha Pane 4 只讀 private Decision Store 與最新已收盤行情，計算 live／shadow 報酬，不寫任何 authority。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\prepare_research_action.py", "--action-file"],
    decision="allow",
    justification="Daily pq1 只把已驗證 action draft 凍結到 ignored private staging；不寫 Neo4j、不 apply、不建立 live permission。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\publish_daily_state.py"],
    decision="allow",
    justification="固定 publisher 只提交兩個 daily state files 並推送 master。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "decision_lab", "today"],
    decision="allow",
    justification="Daily decision brief 只讀 Google Sheet、Neo4j 與 private Decision authorities。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "-m", "engine_b.todo", "sync"],
    decision="allow",
    justification="Daily todo sync 只同步本機 approval authorities 到 stable todo pool。",
)

prefix_rule(
    pattern=[".venv\\Scripts\\python.exe", "scripts\\publish_daily_brief.py"],
    decision="allow",
    justification="Discord publisher 只把 canonical Daily Brief 送到既有 private Forum webhook。",
)
